PORT=5000
NODE_ENV=development
DB_USER=postgres
DB_HOST=localhost
DB_NAME=scolarhub
DB_PASS=password
DB_PORT=5432
JWT_SECRET=your_jwt_secret_key_CHANGE_ME
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Optional: Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Optional: Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: Orange Money Configuration
ORANGE_MONEY_CLIENT_ID=your_orange_money_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_money_client_secret


# ─── Notifications d'inscription (SMS + Email) ────────────────────────────────
APP_URL=http://localhost:8080
SMS_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@scolarhub.bf
EMAIL_FROM_NAME=ScolarHub
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
SENDGRID_API_KEY=
